# 로컬 개발용 환경변수 예시 — 복사해서 .env 로 쓰고 커밋하지 않는다.
# IntelliJ: Run Configuration > Environment variables 에 붙여넣거나 EnvFile 플러그인 사용

# 로컬 MySQL 포트 — 호스트 3306 이 이미 쓰이는 경우에만 바꾼다 (compose·앱 양쪽에 적용)
# MYSQL_HOST_PORT=3307
# DB_PORT=3307

# 필수 — JWT 서명 키 (32바이트 이상)
JWT_SECRET=local-dev-secret-key-please-change-this-to-at-least-32-bytes

# Google 로그인 (auth 구현 시 필요)
GOOGLE_CLIENT_ID=

# AI 문제 생성 (ai 구현 시 필요). 개발·부하 테스트는 claude-haiku-4-5
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# S3 (storage 구현 시 필요)
AWS_REGION=ap-northeast-2
S3_BUCKET=passmate-local

# 포트원 (coin 결제 구현 시 필요)
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
