# 로컬 개발용 환경변수 예시 — 복사해서 .env 로 쓰고 커밋하지 않는다.
# IntelliJ: Run Configuration > Environment variables 에 붙여넣거나 EnvFile 플러그인 사용

# 필수 — JWT 서명 키 (32바이트 이상)
JWT_SECRET=local-dev-secret-key-please-change-this-to-at-least-32-bytes

# Google 로그인 — 웹/앱이 쓰는 OAuth 클라이언트 ID.
# ID 토큰 방식만 쓰면 CLIENT_ID 만 있으면 되고, 인가 코드 교환까지 하려면 SECRET·REDIRECT_URI 도 필요하다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Apple 로그인(iOS) — 앱 번들 ID. 비워 두면 application.yml 기본값(org.sesacteamproject.passmate.Passmate)을 쓴다.
# 개발 빌드처럼 번들 ID 가 다르면 쉼표로 이어 적는다.
APPLE_CLIENT_IDS=
# 탈퇴 시 Apple 연결 해제용 — Apple Developer → Keys 에서 "Sign in with Apple" 키(.p8)를 만든 값.
# APPLE_PRIVATE_KEY 는 .p8 파일 내용. 한 줄로 넣어도 된다(BEGIN/END 줄·줄바꿈 생략 가능). 커밋 금지.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# AI — 제공자는 OpenAI.
# ⚠️ 이 키는 호출할 때마다 과금된다. 테스트는 Fake 로만 돌리고, 실제 호출은 허가 후에만 한다.
# 모델은 비워두면 application.yml 기본값을 쓴다. 계정에서 쓸 수 있는 모델로 맞출 것.
OPENAI_API_KEY=
LLM_GENERATION_MODEL=
LLM_ANALYSIS_MODEL=

# S3 (storage 구현 시 필요)
AWS_REGION=ap-northeast-2
S3_BUCKET=passmate-local

# 포트원 (coin 결제 구현 시 필요)
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
